+.lb-col{border:1.5px solid var(--border,#e5ebf3);border-radius:16px;padding:.7rem .7rem .5rem;background:linear-gradient(175deg,color-mix(in srgb,var(--c) 7%,#fff),#fff 40%);display:flex;flex-direction:column;min-height:180px;transition:border-color .2s,box-shadow .2s,transform .2s}
