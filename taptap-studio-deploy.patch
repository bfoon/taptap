+def _guard(var, i, body):
+    """Run ``body`` as step ``i`` of a chain: skipped when already done, refused when an earlier step is missing."""
+    return (f':global {var}; :local s ${var}; :if ([:typeof $s] != "num") do={{ :set s -1 }}; '
