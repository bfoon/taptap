+        gw = _s(s_row.get('gateway')) if f.get('type') == 'static' else _s(f.get('gateway'))
+        gw = gw or _s(f.get('gateway'))
+        wanted = iface == target or (s_row.get('enabled', True) if s_row else f.get('type') in ('dhcp', 'pppoe'))
